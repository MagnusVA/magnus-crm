exports[`web paths write what they wrote before the split > refuses with the same messages 1`] = `
{
  "cancel a pending follow-up on a closed deal": "Only a follow-up on a deal still waiting for its call's result can be canceled; the deal is "Lost: no-show"",
  "cancel a task on a closed deal": "Only a task on an open deal can be canceled; the deal is "Lost: no-show"",
  "closer calls an admin action": "{"code":"auth.insufficient_permissions","message":"Insufficient permissions"}",
  "lost after a no-show": "Cannot mark as lost: the deal is "Lost: no-show"",
  "no-show twice": "Meeting is not scheduled (current: no_show)",
  "reminder in the past": "Reminder must be scheduled in the future",
  "reschedule link on a booked deal": "Can only create reschedule links for no-show opportunities",
}
`;
